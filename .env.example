# Copia questo file in .env e compilalo con i valori del progetto Supabase.

# Project Settings → API
SUPABASE_URL=https://<ref-progetto>.supabase.co
# Chiave pubblica (anon o publishable): serve solo al login, la usa il server Node e mai il browser
SUPABASE_ANON_KEY=

# Pulsante "Connect" in alto nel pannello → Session pooler → URI, con la password del database al posto di [YOUR-PASSWORD].
# È un segreto: dà accesso completo al database. Non condividerlo.
DATABASE_URL=postgresql://postgres.<ref-progetto>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Database Settings → SSL Configuration → Download certificate. Obbligatorio in produzione.
# Percorso del file scaricato, oppure il suo contenuto (da -----BEGIN CERTIFICATE----- in poi, con \n al posto degli a capo).
DATABASE_SSL_CA=

PORT=3000
